# Copy this file to backend/.env and paste the key locally.
# Never commit backend/.env or paste the key into chat.
FOURSQUARE_API_KEY=PASTE_YOUR_SERVICE_API_KEY_HERE

# MySQL production example:
# DATABASE_URL=mysql+pymysql://shuffl_user:password@127.0.0.1:3306/shuffl
# Local development defaults to backend/data/shuffl_admin.db when omitted.
DATABASE_URL=
# Set to 1 for the locked MVP launch profile. Leave unset/0 for local SQLite development.
SHUFFL_REQUIRE_MYSQL=0
ADMIN_API_TOKEN=change-this-in-production
ADMIN_ROLE_TOKENS=SUPER_ADMIN=change-super-admin,ADMIN=change-admin,EDITOR=change-editor,VIEWER=change-viewer
# Google OAuth Web client ID used to verify mobile ID tokens server-side.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=1
APP_ENV=development
# Set to 1 only for an explicit local demo with fixture venues. Keep 0 for API-backed builds.
SHUFFL_DEMO_MODE=0
VENUE_SOURCE_DIR=venue_pipeline_backend/data_auto_only_final_v2
# Comma-separated browser origins. Keep this explicit in staging/production.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Per-client-IP sliding-window limits for API calls.
SHUFFL_RATE_LIMIT_PER_MINUTE=120
SHUFFL_STOP_OPTIONS_RATE_LIMIT_PER_MINUTE=30
# Portable backups are written here by backend/tools/backup_database.py.
BACKUP_DIR=backend/backups
# Freeze automated venue pipeline writes while the current catalogue is live.
VENUE_PIPELINE_LOCKED=1
