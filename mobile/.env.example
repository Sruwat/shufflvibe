# Production Android builds must point at the published venue API.
# Leave unset only for the explicit local fixture/demo mode.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_RELEASE_SCOPE=mvp
# Google OAuth client IDs from Google Cloud Console. The web client ID must
# match backend GOOGLE_OAUTH_CLIENT_ID for server-side ID-token verification.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
