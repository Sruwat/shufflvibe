# Production Android builds must point at the published venue API.
# Leave unset only for the explicit local fixture/demo mode.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_RELEASE_SCOPE=mvp
# Demo fixtures are disabled by default. Set to 1 only for isolated UI tests.
EXPO_PUBLIC_DEMO_MODE=0
# Google OAuth client IDs from Google Cloud Console. The web client ID must
# match backend GOOGLE_OAUTH_CLIENT_ID for server-side ID-token verification.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=257183800931-8cfnfbfa8odea04041q19dtlbu9hnhbr.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=257183800931-2l3ba592nqj290v3krckn8lau9v8tbpb.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=257183800931-s6sd4sk7nqf02nbooc148buidl7n187v.apps.googleusercontent.com
